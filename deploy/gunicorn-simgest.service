[Unit]
Description=Gunicorn para SimGest
After=network.target postgresql.service

[Service]
User=simgest
Group=simgest
WorkingDirectory=/var/www/simgest/app
ExecStart=/var/www/simgest/venv/bin/gunicorn simgest.wsgi:application \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure

[Install]
WantedBy=multi-user.target
