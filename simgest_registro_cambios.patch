@@ -0,0 +1,74 @@
+<!DOCTYPE html>
+<html lang="es">
+<head>
+  <meta charset="UTF-8">
+  <title>SimGest - Registro</title>
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
+  <style>
+    :root {
+      --granate: #B71C3C;
+      --azul-petroleo: #0E2A3C;
+    }
+    body {
+      background-color: var(--azul-petroleo);
+      min-height: 100vh;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      padding: 24px 0;
+    }
+    .registro-card { max-width: 420px; width: 100%; border-radius: 12px; border: none; }
+    .btn-granate { background-color: var(--granate); color: #fff; border: none; width: 100%; }
+    .btn-granate:hover { background-color: #97162f; color: #fff; }
+  </style>
+</head>
+<body>
+  <div class="card registro-card p-4">
+    <h4 class="text-center mb-1" style="color: var(--azul-petroleo);">SimGest</h4>
+    <p class="text-center text-muted small mb-4">Crea tu cuenta de cliente</p>
+
+    {% if messages %}
+      {% for message in messages %}
+        <div class="alert alert-success py-2">{{ message }}</div>
+      {% endfor %}
+    {% endif %}
+
+    {% if form.non_field_errors %}
+      <div class="alert alert-danger py-2">{{ form.non_field_errors }}</div>
+    {% endif %}
+
+    <form method="post">
+      {% csrf_token %}
+      <div class="mb-3">
+        <label class="form-label">{{ form.nombre.label }}</label>
+        {{ form.nombre }}
+        {% for error in form.nombre.errors %}<div class="text-danger small">{{ error }}</div>{% endfor %}
+      </div>
+      <div class="mb-3">
+        <label class="form-label">{{ form.email.label }}</label>
+        {{ form.email }}
+        {% for error in form.email.errors %}<div class="text-danger small">{{ error }}</div>{% endfor %}
+      </div>
+      <div class="mb-3">
+        <label class="form-label">{{ form.telefono.label }}</label>
+        {{ form.telefono }}
+      </div>
+      <div class="mb-3">
+        <label class="form-label">{{ form.password.label }}</label>
+        {{ form.password }}
+        {% for error in form.password.errors %}<div class="text-danger small">{{ error }}</div>{% endfor %}
+      </div>
+      <div class="mb-3">
+        <label class="form-label">{{ form.password2.label }}</label>
+        {{ form.password2 }}
+        {% for error in form.password2.errors %}<div class="text-danger small">{{ error }}</div>{% endfor %}
+      </div>
+      <button type="submit" class="btn btn-granate mt-2">Crear cuenta</button>
+      <p class="text-center small mt-3 mb-0">
+        <a href="{% url 'simulactores:login' %}">Ya tengo cuenta</a>
+      </p>
+    </form>
+  </div>
+</body>
+</html>
